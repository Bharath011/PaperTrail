{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "papertrail-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://bharath011.github.io,http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "papertrail-shared",
      "database_id": "079d5fcd-61c9-4070-a296-95b0531a725b",
      "migrations_dir": "drizzle"
    }
  ]
}
